{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "デスクトップアプリのデフォルト権限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "opener:allow-open-url",
    "store:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [{ "url": "https://restart2api.restart-reboot.com/**" }]
    }
  ]
}
